# Normalise line endings: LF in the repo and on checkout everywhere.
# Prevents CRLF from a Windows commit breaking scripts on the Linux server.
* text=auto eol=lf

*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf

# Binary — never touch these.
*.pt    binary
*.pth   binary
*.grib2 binary
*.nc    binary
